<?xml version="1.0" encoding="utf-8"?>
<!-- Keys and defaults must match WidgetPrefs / WidgetViewCreator. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/design_header">
        <ListPreference
            app:defaultValue="default"
            app:entries="@array/font_list"
            app:entryValues="@array/font_list_values"
            app:icon="@drawable/ic_font"
            app:key="sp_font"
            app:title="@string/clock_font_header"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="0"
            app:entries="@array/widget_layout_titles"
            app:entryValues="@array/widget_layout_values"
            app:icon="@drawable/ic_layout"
            app:key="sp_layout"
            app:title="@string/widget_layout_title"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="custom"
            app:entries="@array/color_mode_titles"
            app:entryValues="@array/color_mode_values"
            app:icon="@drawable/ic_colorize"
            app:isPreferenceVisible="false"
            app:key="sp_color_mode"
            app:title="@string/color_mode_title"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/time_header">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:icon="@drawable/ic_clock"
            app:key="sp_show_time"
            app:title="@string/show_time_title" />
        <com.jaredrummler.android.colorpicker.ColorPreferenceCompat
            app:cpv_showAlphaSlider="false"
            app:defaultValue="-1"
            app:icon="@drawable/ic_colorize"
            app:key="sp_clock_color"
            app:title="@string/color_picker_header" />
        <EditTextPreference
            app:defaultValue=""
            app:dialogMessage="@string/time_format_dialog_msg"
            app:icon="@drawable/ic_text"
            app:key="sp_time_format"
            app:title="@string/time_format_title" />
        <SeekBarPreference
            android:max="100"
            app:defaultValue="42"
            app:icon="@drawable/ic_size"
            app:key="sp_time_size"
            app:min="8"
            app:showSeekBarValue="true"
            app:title="@string/time_size_title" />
        <ListPreference
            app:defaultValue="17"
            app:entries="@array/text_align_keys"
            app:entryValues="@array/text_align_values"
            app:icon="@drawable/ic_align"
            app:key="sp_time_align"
            app:title="@string/time_align_title"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/date_header">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:icon="@drawable/ic_calander"
            app:key="sp_show_date"
            app:title="@string/show_date_title" />
        <com.jaredrummler.android.colorpicker.ColorPreferenceCompat
            app:cpv_showAlphaSlider="false"
            app:defaultValue="-1"
            app:icon="@drawable/ic_colorize"
            app:key="sp_date_color"
            app:title="@string/date_color_picker_title" />
        <EditTextPreference
            app:defaultValue="EEE, MMM d"
            app:dialogMessage="@string/date_format_dialog_msg"
            app:icon="@drawable/ic_text"
            app:key="sp_date_format"
            app:title="@string/date_format_title"
            app:useSimpleSummaryProvider="true" />
        <SeekBarPreference
            android:max="100"
            app:defaultValue="22"
            app:icon="@drawable/ic_size"
            app:key="sp_date_size"
            app:min="8"
            app:showSeekBarValue="true"
            app:title="@string/date_size_title" />
        <ListPreference
            app:defaultValue="17"
            app:entries="@array/text_align_keys"
            app:entryValues="@array/text_align_values"
            app:icon="@drawable/ic_align"
            app:key="sp_date_align"
            app:title="@string/date_align_title"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

</PreferenceScreen>
